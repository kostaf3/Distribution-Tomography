Notebook[{

Cell[CellGroupData[{
Cell[TextData[StyleBox["Projections",
 FontColor->GrayLevel[0]]], "Subsection",
 CellChangeTimes->{{3.9388638371176186`*^9, 
  3.938863838726008*^9}},ExpressionUUID->"b9657d92-1732-45d5-8182-\
0823270725f2"],

Cell["\<\
This code takes an analytic expression of a distribution in spherical \
coordinates as input, rotates it and produces its projection for each \
rotational angle.
You can select the polarization type and the number of slices and projections.\
\>", "Text",
 CellChangeTimes->{{3.9388641960413313`*^9, 3.9388642187111588`*^9}, {
  3.938864253010476*^9, 3.9388643803515053`*^9}, {3.938865409805521*^9, 
  3.9388654101134768`*^9}, {3.9388664280171666`*^9, 3.938866459906439*^9}, {
  3.9388735216762257`*^9, 
  3.9388735434626503`*^9}},ExpressionUUID->"80942097-1112-4930-8ed8-\
45c46838e646"],

Cell[TextData[{
 "Notes: a)The laser polarization is assumed as: ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["z", "\[RightArrow]"], TraditionalForm]],ExpressionUUID->
  "f18bb5bb-c5e1-4bbf-9df9-e72d23e15df0"],
 "=p ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["x", "^"], TraditionalForm]],ExpressionUUID->
  "915471d7-2cf6-4457-91bf-4573bb2b2e39"],
 " +\[Eta] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", "i\[Delta]"], TraditionalForm]],
  ExpressionUUID->"27cf1087-8282-4723-9c07-71a8fc84c659"],
 Cell[BoxData[
  FormBox[
   OverscriptBox["y", "^"], TraditionalForm]],ExpressionUUID->
  "99b152b1-09d1-494b-b7c2-7c6dcf6e755a"],
 ".\n\t    b)The distribution is projected along the y axis."
}], "Text",
 CellChangeTimes->{{3.9388645017384953`*^9, 3.938864625213159*^9}, {
  3.938865510711938*^9, 3.9388655427050095`*^9}, {3.938866480140956*^9, 
  3.9388664828137417`*^9}, {3.9388736275027556`*^9, 
  3.938873628041144*^9}},ExpressionUUID->"8e95f20e-0cae-4296-a72a-\
6fc948199f46"],

Cell["How to run the code: ", "Text",
 CellChangeTimes->{{3.9388646495905237`*^9, 
  3.938864723385557*^9}},ExpressionUUID->"e3727064-11ce-4724-bd15-\
2295e45dbee1"],

Cell["\<\
1.Press Evaluate Notebook (Evaluation>Evaluate Notebook) or Shift+Enter on \
the group cell.\
\>", "Text",
 CellDingbat->"\[DiamondSuit]",
 CellChangeTimes->{{3.938864658502675*^9, 3.9388646589189825`*^9}, 
   3.9388647248280272`*^9, 
   3.9388655459890747`*^9},ExpressionUUID->"adea34f6-22ef-45ff-a633-\
1f6d8cf318af"],

Cell["\<\
2.Write the analytical expression in the \"Expression\" box. One is given \
already.\
\>", "Text",
 CellDingbat->"\[DiamondSuit]",
 CellChangeTimes->{{3.9388648260061336`*^9, 3.9388648516733108`*^9}, {
  3.9388650366623764`*^9, 
  3.938865037464738*^9}},ExpressionUUID->"977fb671-e1cc-4394-970e-\
ae96832026de"],

Cell["3.Fill the polarization and tomographic parameters.", "Text",
 CellDingbat->"\[DiamondSuit]",
 CellChangeTimes->{{3.938864865880025*^9, 
  3.938864912088978*^9}},ExpressionUUID->"5f7a5326-9cf7-4b54-9831-\
cbea240a8ee1"],

Cell["Press the \"Run\" button.", "Text",
 CellDingbat->"\[DiamondSuit]",
 CellChangeTimes->{{3.9388649330102205`*^9, 
  3.9388649617817564`*^9}},ExpressionUUID->"a271b402-d646-4566-a692-\
08c06624a4ab"],

Cell["\<\
 It may take some time depending on the number of projections and slices you \
selected.
The code saves the projections as DAT files in the folder where the Notebook \
is stored.\
\>", "Text",
 CellChangeTimes->{{3.938864964935588*^9, 3.9388650218559403`*^9}, {
  3.938865054660454*^9, 3.9388650553271117`*^9}, {3.93886541907039*^9, 
  3.9388654193232574`*^9}, {3.938865470576482*^9, 
  3.9388654721230245`*^9}},ExpressionUUID->"954e59f5-541d-4507-9137-\
9c27c60833a6"],

Cell["\<\
Tip: write the analytic expression in a new cell and copy-paste it in the \
Expresion box.\
\>", "Text",
 CellChangeTimes->{{3.938864240626494*^9, 3.938864246395196*^9}, {
  3.9388653519297633`*^9, 3.938865394473652*^9}, {3.9388749509795437`*^9, 
  3.9388749538236337`*^9}},ExpressionUUID->"54c09373-20af-48d4-89a9-\
d229f0a07123"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "initialization", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "FrontEndTokenExecute", "[", "\"\<DeleteGeneratedCells\>\"", "]"}], ";"}],
    "\n", 
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"$HistoryLength", "=", "0"}], ";"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SetDirectory", "[", 
     RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"CurrentValue", "[", 
      RowBox[{"$FrontEndSession", ",", "\"\<NotebookBrowseDirectory\>\""}], 
      "]"}], "=", 
     RowBox[{"NotebookDirectory", "[", 
      RowBox[{"EvaluationNotebook", "[", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"DynamicModule", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"expression1", "=", 
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{
            RowBox[{
             RowBox[{"-", 
              SuperscriptBox["\[Eta]", "2"]}], " ", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{"2", "I", " ", "\[Delta]"}]]}], "+", 
            SuperscriptBox["p", "2"], "+", 
            RowBox[{"2", "I", " ", "p", " ", "\[Eta]", " ", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{"I", " ", "\[Delta]"}]]}]}], 
           SqrtBox["30"]], 
          RowBox[{"SphericalHarmonicY", "[", 
           RowBox[{"2", ",", 
            RowBox[{"-", "2"}], ",", "\[Theta]", ",", "\[Phi]"}], "]"}]}], 
         "-", 
         RowBox[{
          FractionBox[
           RowBox[{
            RowBox[{
             SuperscriptBox["\[Eta]", "2"], " ", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{"2", "I", " ", "\[Delta]"}]]}], "+", 
            SuperscriptBox["p", "2"]}], 
           RowBox[{"3", 
            SqrtBox["5"]}]], 
          RowBox[{"SphericalHarmonicY", "[", 
           RowBox[{"2", ",", "0", ",", "\[Theta]", ",", "\[Phi]"}], "]"}]}], 
         "+", 
         RowBox[{
          FractionBox[
           RowBox[{
            RowBox[{
             RowBox[{"-", 
              SuperscriptBox["\[Eta]", "2"]}], " ", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{"2", "I", " ", "\[Delta]"}]]}], "+", 
            SuperscriptBox["p", "2"], "-", 
            RowBox[{"2", "I", " ", "p", " ", "\[Eta]", " ", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{"I", " ", "\[Delta]"}]]}]}], 
           SqrtBox["30"]], 
          RowBox[{"SphericalHarmonicY", "[", 
           RowBox[{"2", ",", "2", ",", "\[Theta]", ",", "\[Phi]"}], 
           "]"}]}]}]}], ",", 
       RowBox[{"\[Eta]1", "=", "0"}], ",", 
       RowBox[{"\[Delta]1", "=", "0"}], ",", 
       RowBox[{"p1", "=", "1"}], ",", 
       RowBox[{"numberOfSlices1", "=", "30"}], ",", "numberOfSlices", ",", 
       RowBox[{"numberOfProjections1", "=", "30"}], ",", 
       "numberOfProjections", ",", "nop", ",", "steps", ",", "expression", 
       ",", "polarexpression", ",", "f", ",", "xMax", ",", "yMax", ",", 
       "zMax", ",", "arrayMax", ",", "xAxisPoints", ",", "yAxisPointsTom", 
       ",", "zAxisPoints", ",", "axisOfRotation"}], " ", "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Framed", "@", 
      RowBox[{"Panel", "[", 
       RowBox[{
        RowBox[{"Column", "[", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Grid", "[", 
            RowBox[{
             RowBox[{"{", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{"panel", " ", "buttons"}], "*)"}], 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<Expression: \>\"", ",", "16", ",", 
                   RowBox[{"FontFamily", "->", "\"\<Times New Roman\>\""}]}], 
                  "]"}], ",", 
                 RowBox[{"InputField", "[", 
                  RowBox[{
                   RowBox[{"Dynamic", "[", "expression1", "]"}], ",", 
                   RowBox[{"FieldSize", "->", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"40", ",", "40"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"10", ",", "Infinity"}], "}"}]}], "}"}]}], ",", 
                   RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], "}"}], 
               ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<\[Eta]: \>\"", ",", "16", ",", 
                   RowBox[{"FontFamily", "->", "\"\<Times New Roman\>\""}]}], 
                  "]"}], ",", 
                 RowBox[{"InputField", "[", 
                  RowBox[{
                   RowBox[{"Dynamic", "[", "\[Eta]1", "]"}], ",", "Number", 
                   ",", 
                   RowBox[{"FieldSize", "->", 
                    RowBox[{"{", 
                    RowBox[{"16", ",", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "Infinity"}], "}"}]}], "}"}]}], ",", 
                   RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], "}"}], 
               ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<p: \>\"", ",", "16", ",", 
                   RowBox[{"FontFamily", "->", "\"\<Times New Roman\>\""}]}], 
                  "]"}], ",", 
                 RowBox[{"InputField", "[", 
                  RowBox[{
                   RowBox[{"Dynamic", "[", "p1", "]"}], ",", "Number", ",", 
                   RowBox[{"FieldSize", "->", 
                    RowBox[{"{", 
                    RowBox[{"16", ",", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "Infinity"}], "}"}]}], "}"}]}], ",", 
                   RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], "}"}], 
               ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<\[Delta]: \>\"", ",", "16", ",", 
                   RowBox[{"FontFamily", "->", "\"\<Times New Roman\>\""}]}], 
                  "]"}], ",", 
                 RowBox[{"InputField", "[", 
                  RowBox[{
                   RowBox[{"Dynamic", "[", "\[Delta]1", "]"}], ",", 
                   RowBox[{"FieldSize", "->", 
                    RowBox[{"{", 
                    RowBox[{"16", ",", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], ",", 
                   RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], "}"}], 
               ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<Number of slices:\>\"", ",", "16", ",", 
                   RowBox[{"FontFamily", "->", "\"\<Times New Roman\>\""}]}], 
                  "]"}], ",", 
                 RowBox[{"InputField", "[", 
                  RowBox[{
                   RowBox[{"Dynamic", "[", "numberOfSlices1", "]"}], ",", 
                   "Number", ",", 
                   RowBox[{"FieldSize", "->", 
                    RowBox[{"{", 
                    RowBox[{"16", ",", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "Infinity"}], "}"}]}], "}"}]}], ",", 
                   RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], "}"}], 
               ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<Number of projections:\>\"", ",", "16", ",", 
                   RowBox[{"FontFamily", "->", "\"\<Times New Roman\>\""}]}], 
                  "]"}], ",", 
                 RowBox[{"InputField", "[", 
                  RowBox[{
                   RowBox[{"Dynamic", "[", "numberOfProjections1", "]"}], ",",
                    "Number", ",", 
                   RowBox[{"FieldSize", "->", 
                    RowBox[{"{", 
                    RowBox[{"16", ",", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "Infinity"}], "}"}]}], "}"}]}], ",", 
                   RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], "}"}]}], 
              "}"}], ",", 
             RowBox[{"Alignment", "->", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"Center", ",", "Center"}], "}"}], ",", "Center"}], 
               "}"}]}], ",", 
             RowBox[{"Dividers", "->", "All"}]}], "]"}], ",", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"main", " ", "code"}], "*)"}], "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"Button", "[", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"\"\<Run\>\"", ",", "14"}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"PrintTemporary", "[", 
               RowBox[{"Row", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Style", "[", 
                   RowBox[{
                   "\"\<Processing \\nPlease wait . . .\>\"", ",", "14", ",", 
                    RowBox[{"FontFamily", "->", "\"\<Cambria\>\""}]}], "]"}], 
                  ",", 
                  RowBox[{"Spacer", "[", "20", "]"}], ",", 
                  RowBox[{"ProgressIndicator", "[", 
                   RowBox[{
                    RowBox[{"Dynamic", "[", 
                    RowBox[{"Clock", "[", "Infinity", "]"}], "]"}], ",", 
                    "Indeterminate"}], "]"}]}], "}"}], "]"}], "]"}], ";", 
              "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"(*", "parameters", "*)"}], "\[IndentingNewLine]", 
              RowBox[{"axisOfRotation", "=", 
               RowBox[{"{", 
                RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], ";", " ", 
              "\[IndentingNewLine]", 
              RowBox[{"nop", "=", "200."}], ";", "\[IndentingNewLine]", 
              RowBox[{"steps", "=", "nop"}], ";", "\[IndentingNewLine]", 
              RowBox[{"numberOfSlices", "=", 
               RowBox[{"N", "[", "numberOfSlices1", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"numberOfProjections", "=", 
               RowBox[{"N", "[", "numberOfProjections1", "]"}]}], ";", 
              "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
               "more", " ", "parameters", " ", "and", " ", "functions"}], 
               "*)"}], "\[IndentingNewLine]", 
              RowBox[{"expression", "=", 
               RowBox[{"expression1", "/.", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"\[Eta]", "->", "\[Eta]1"}], ",", 
                  RowBox[{"\[Delta]", "->", "\[Delta]1"}], ",", 
                  RowBox[{"p", "->", "p1"}]}], "}"}]}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"polarexpression", "=", 
               RowBox[{
                RowBox[{"FullSimplify", "[", 
                 RowBox[{"ComplexExpand", "[", 
                  RowBox[{"TrigExpand", "[", 
                   RowBox[{
                    RowBox[{"Conjugate", "[", "expression", "]"}], " ", 
                    "expression"}], "]"}], "]"}], "]"}], "//", "Chop"}]}], 
              ";", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"f", "[", 
                RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], "=", 
               RowBox[{"Assuming", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"x", "\[Element]", "Reals"}], "&&", 
                  RowBox[{"y", "\[Element]", "Reals"}], "&&", 
                  RowBox[{"z", "\[Element]", "Reals"}]}], ",", 
                 RowBox[{"Chop", "@", 
                  RowBox[{"FullSimplify", "[", 
                   RowBox[{"TransformedField", "[", 
                    RowBox[{
                    RowBox[{"\"\<Spherical\>\"", "->", "\"\<Cartesian\>\""}], 
                    ",", 
                    RowBox[{"polarexpression", "//", "TrigExpand"}], ",", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"r", ",", "\[Theta]", ",", "\[Phi]"}], "}"}], "->", 
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y", ",", "z"}], "}"}]}]}], "]"}], 
                   "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
              "\[IndentingNewLine]", 
              RowBox[{"xMax", "=", 
               RowBox[{"Ceiling", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Quiet", "@", 
                   RowBox[{"NMaxValue", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"x", ",", 
                    RowBox[{
                    SqrtBox[
                    RowBox[{
                    SuperscriptBox["x", "2"], "+", 
                    SuperscriptBox["y", "2"], "+", 
                    SuperscriptBox["z", "2"]}]], "<=", 
                    RowBox[{"f", "[", 
                    RowBox[{"x", ",", "y", ",", "z"}], "]"}]}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
                    RowBox[{"Method", "->", "\"\<SimulatedAnnealing\>\""}]}], 
                    "]"}]}], "//", "N"}], ",", "0.01"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"yMax", "=", 
               RowBox[{"Ceiling", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Quiet", "@", 
                   RowBox[{"NMaxValue", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"y", ",", 
                    RowBox[{
                    SqrtBox[
                    RowBox[{
                    SuperscriptBox["x", "2"], "+", 
                    SuperscriptBox["y", "2"], "+", 
                    SuperscriptBox["z", "2"]}]], "<=", 
                    RowBox[{"f", "[", 
                    RowBox[{"x", ",", "y", ",", "z"}], "]"}]}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
                    RowBox[{"Method", "->", "\"\<SimulatedAnnealing\>\""}]}], 
                    "]"}]}], "//", "N"}], ",", "0.01"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"zMax", "=", 
               RowBox[{"Ceiling", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Quiet", "@", 
                   RowBox[{"NMaxValue", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"z", ",", 
                    RowBox[{
                    SqrtBox[
                    RowBox[{
                    SuperscriptBox["x", "2"], "+", 
                    SuperscriptBox["y", "2"], "+", 
                    SuperscriptBox["z", "2"]}]], "<=", 
                    RowBox[{"f", "[", 
                    RowBox[{"x", ",", "y", ",", "z"}], "]"}]}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
                    RowBox[{"Method", "->", "\"\<SimulatedAnnealing\>\""}]}], 
                    "]"}]}], "//", "N"}], ",", "0.01"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"arrayMax", "=", 
               RowBox[{"Max", "[", 
                RowBox[{"xMax", ",", "zMax"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"xAxisPoints", "=", 
               RowBox[{
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"-", 
                    FractionBox["1", "2"]}], 
                    RowBox[{"(", 
                    RowBox[{"2", "arrayMax"}], ")"}]}], "+", 
                   RowBox[{
                    FractionBox[
                    RowBox[{
                    RowBox[{"2", "i"}], "-", "1"}], 
                    RowBox[{"2", "steps"}]], 
                    RowBox[{"(", 
                    RowBox[{"2", "arrayMax"}], ")"}]}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"i", ",", "1", ",", "steps"}], "}"}]}], "]"}], "/.", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"x_", "/;", 
                   RowBox[{
                    RowBox[{"Abs", "[", "x", "]"}], "<", 
                    SuperscriptBox["10", 
                    RowBox[{"-", "4"}]]}]}], "->", 
                  SuperscriptBox["10", 
                   RowBox[{"-", "7."}]]}], "}"}]}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"yAxisPointsTom", "=", 
               RowBox[{
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"-", 
                    FractionBox["1", "2"]}], 
                    RowBox[{"(", 
                    RowBox[{"2", "arrayMax"}], ")"}]}], "+", 
                   RowBox[{
                    FractionBox[
                    RowBox[{
                    RowBox[{"2", "i"}], "-", "1"}], 
                    RowBox[{"2", "steps"}]], 
                    RowBox[{"(", 
                    RowBox[{"2", "arrayMax"}], ")"}]}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"i", ",", "steps", ",", "1", ",", 
                    RowBox[{"-", "1"}]}], "}"}]}], "]"}], "/.", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"x_", "/;", 
                   RowBox[{
                    RowBox[{"Abs", "[", "x", "]"}], "<", 
                    SuperscriptBox["10", 
                    RowBox[{"-", "4"}]]}]}], "->", 
                  SuperscriptBox["10", 
                   RowBox[{"-", "7."}]]}], "}"}]}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"zAxisPoints", "=", 
               RowBox[{"N", "[", 
                RowBox[{
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"-", 
                    FractionBox["1", "2"]}], 
                    RowBox[{"(", 
                    RowBox[{"2", "arrayMax"}], ")"}]}], "+", 
                    RowBox[{
                    FractionBox[
                    RowBox[{
                    RowBox[{"2", "i"}], "-", "1"}], 
                    RowBox[{"2", "steps"}]], 
                    RowBox[{"(", 
                    RowBox[{"2", "arrayMax"}], ")"}]}]}], ",", 
                   RowBox[{"{", 
                    RowBox[{"i", ",", "1", ",", "steps", ",", 
                    FractionBox["steps", "numberOfSlices"]}], "}"}]}], "]"}], 
                 "/.", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"x_", "/;", 
                    RowBox[{
                    RowBox[{"Abs", "[", "x", "]"}], "<", 
                    SuperscriptBox["10", 
                    RowBox[{"-", "4"}]]}]}], "->", 
                   SuperscriptBox["10", 
                    RowBox[{"-", "7."}]]}], "}"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
               "the", " ", "projection", " ", "data", " ", "are", " ", 
                "produced", " ", "here"}], "*)"}], "\[IndentingNewLine]", 
              RowBox[{"Module", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"time", ",", 
                  RowBox[{"projections", "=", 
                   RowBox[{"{", "}"}]}], ",", "fRot", ",", "projectionsrot", 
                  ",", 
                  RowBox[{"projectionsImages", "=", 
                   RowBox[{"{", "}"}]}]}], "}"}], ",", 
                RowBox[{
                 RowBox[{"time", "=", 
                  RowBox[{
                   RowBox[{"Monitor", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    "projections", "=", "\[IndentingNewLine]", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Table", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"fRot", "[", 
                    RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], "=", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"f", "[", 
                    RowBox[{"x", ",", "y", ",", "z"}], "]"}], "/.", 
                    RowBox[{"Thread", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y", ",", "z"}], "}"}], "->", 
                    RowBox[{
                    RowBox[{"RotationTransform", "[", 
                    RowBox[{
                    RowBox[{"angleOfRotation", " ", "Degree"}], ",", 
                    "axisOfRotation"}], "]"}], "[", 
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y", ",", "z"}], "}"}], "]"}]}], 
                    "]"}]}], "//", "N"}], "//", "FullSimplify"}], "//", 
                    "Chop"}]}], ";", "\[IndentingNewLine]", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"projectionsrot", "[", 
                    RowBox[{
                    RowBox[{"x_", "?", "NumericQ"}], ",", 
                    RowBox[{"z_", "?", "NumericQ"}]}], "]"}], ":=", 
                    RowBox[{"Quiet", "@", 
                    RowBox[{"NIntegrate", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"fRot", "[", 
                    RowBox[{"x", ",", "y", ",", "z"}], "]"}], 
                    RowBox[{"Boole", "[", 
                    RowBox[{
                    SqrtBox[
                    RowBox[{
                    SuperscriptBox["x", "2"], "+", 
                    SuperscriptBox["y", "2"], "+", 
                    SuperscriptBox["z", "2"]}]], "<=", 
                    RowBox[{"fRot", "[", 
                    RowBox[{"x", ",", "y", ",", "z"}], "]"}]}], "]"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"y", ",", 
                    RowBox[{"-", "arrayMax"}], ",", "arrayMax"}], "}"}], ",", 
                    RowBox[{"MaxRecursion", "\[Rule]", "50"}], ",", 
                    RowBox[{"MinRecursion", "->", "2"}], ",", 
                    RowBox[{"Method", "\[Rule]", 
                    RowBox[{"{", 
                    RowBox[{"\"\<LocalAdaptive\>\"", ",", 
                    RowBox[{"\"\<SymbolicProcessing\>\"", "\[Rule]", "0"}]}], 
                    "}"}]}]}], "]"}]}]}], ";", "  ", "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{
                    "Perhaps", " ", "with", " ", "ParallelTable", " ", "this",
                     " ", "would", " ", "be", " ", "faster", " ", "but", " ", 
                    "it", " ", "produced", " ", 
                    RowBox[{"errors", ".", "However"}]}], ",", 
                    RowBox[{
                    "the", " ", "difference", " ", "in", " ", "values", " ", 
                    "between", " ", "these", " ", "two", " ", "is", " ", 
                    "very", " ", "small"}]}], "*)"}], "\[IndentingNewLine]", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"projectionsrot", "[", 
                    RowBox[{"xPlane", ",", "zPlane"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"xPlane", ",", "xAxisPoints"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"zPlane", ",", "zAxisPoints"}], "}"}]}], "]"}]}], 
                    ",", 
                    RowBox[{"{", 
                    RowBox[{"angleOfRotation", ",", 
                    RowBox[{"N", "[", 
                    RowBox[{"Most", "[", 
                    RowBox[{"Range", "[", 
                    RowBox[{"0", ",", "180", ",", 
                    FractionBox["180", "numberOfProjections1"]}], "]"}], 
                    "]"}], "]"}]}], "}"}]}], "]"}]}], ";"}], 
                    "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"StringForm", "[", 
                    RowBox[{
                    "\"\<Currently calculating projection at \[Theta]= `` \
Degrees out of 180 \>\"", ",", 
                    RowBox[{"N", "[", 
                    RowBox[{"angleOfRotation", ",", "0.1"}], "]"}]}], "]"}], 
                    ",", "Bold", ",", "Red"}], "]"}]}], "]"}], "//", 
                   "AbsoluteTiming"}]}], ";", "\[IndentingNewLine]", 
                 "\[IndentingNewLine]", "\[IndentingNewLine]", 
                 RowBox[{"(*", 
                  RowBox[{
                  "the", " ", "projection", " ", "data", " ", "are", " ", 
                   "converted", " ", "to", " ", "images"}], "*)"}], 
                 "\[IndentingNewLine]", 
                 RowBox[{"projectionsImages", "=", 
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"ImageAdjust", "@", 
                    RowBox[{"ImageResize", "[", 
                    RowBox[{
                    RowBox[{"Image", "[", 
                    RowBox[{"Rescale", "[", 
                    RowBox[{"projections", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"nop", ",", "nop"}], "}"}]}], "]"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "numberOfProjections"}], "}"}]}], 
                   "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]",
                  "\[IndentingNewLine]", 
                 RowBox[{"(*", 
                  RowBox[{
                  "the", " ", "projection", " ", "data", " ", "are", " ", 
                   "exported"}], "*)"}], "\[IndentingNewLine]", 
                 "\[IndentingNewLine]", 
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{"Export", "[", 
                    RowBox[{
                    RowBox[{"FileNameJoin", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Directory", "[", "]"}], ",", 
                    RowBox[{"StringJoin", "[", 
                    RowBox[{"\"\<UI projection=\>\"", ",", 
                    RowBox[{"ToString", "[", "i", "]"}], ",", 
                    "\"\< with number of slices=\>\"", ",", 
                    RowBox[{"ToString", "[", "numberOfSlices", "]"}], ",", 
                    "\"\<dat\>\""}], "]"}]}], "}"}], "]"}], ",", 
                    RowBox[{"projections", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "\"\<Table\>\""}], 
                    "]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"i", ",", "numberOfProjections"}], "}"}]}], "]"}],
                  ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
                 RowBox[{"(*", 
                  RowBox[{
                  "create", " ", "a", " ", "window", " ", "where", " ", "the",
                    " ", "projection", " ", "images", " ", "are", " ", 
                   "shown", " ", "with", " ", "other", " ", "parameters"}], 
                  "*)"}], "\[IndentingNewLine]", 
                 RowBox[{"CreateDocument", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Column", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"TextCell", "[", 
                    RowBox[{
                    "\"\<Calculation Complete. Here are the projections:\>\"",
                     ",", "\"\<Subtitle\>\"", ",", 
                    RowBox[{"TextAlignment", "->", "Center"}]}], "]"}], ",", 
                    RowBox[{"Row", "[", 
                    RowBox[{
                    RowBox[{"j", "=", "0"}], ";", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"j", "++"}], ";", 
                    RowBox[{"Labeled", "[", 
                    RowBox[{
                    RowBox[{"Framed", "@", 
                    RowBox[{"ImageResize", "[", 
                    RowBox[{
                    RowBox[{"projectionsImages", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], ",", "Large"}], "]"}]}], 
                    ",", 
                    RowBox[{"StringJoin", "[", 
                    RowBox[{"\"\<\[Theta]=\>\"", ",", 
                    RowBox[{"ToString", "[", "i", "]"}]}], "]"}], ",", 
                    "Top"}], "]"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", 
                    RowBox[{"N", "[", 
                    RowBox[{"Most", "[", 
                    RowBox[{"Range", "[", 
                    RowBox[{"0", ",", "180", ",", 
                    FractionBox["180", "numberOfProjections1"]}], "]"}], 
                    "]"}], "]"}]}], "}"}]}], "]"}]}], "]"}]}], "}"}], "]"}], 
                    ",", 
                    RowBox[{"Column", "[", 
                    RowBox[{"{", 
                    RowBox[{"TextCell", "[", 
                    RowBox[{"StringJoin", "[", 
                    RowBox[{"\"\<Total time of calculation=\>\"", ",", 
                    RowBox[{"ToString", "[", 
                    RowBox[{"Round", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"time", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "/", "60"}], ",", 
                    "0.01"}], "]"}], "]"}], ",", "\"\<(minutes)\>\""}], "]"}],
                     "]"}], "}"}], "]"}]}], "}"}], ",", 
                   RowBox[{
                   "WindowTitle", "->", "\"\<Calculation Result\>\""}]}], 
                  "]"}], ";"}]}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
             RowBox[{"Method", "->", "\"\<Queued\>\""}]}], "]"}]}], 
          "\[IndentingNewLine]", "\[IndentingNewLine]", "}"}], "]"}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"ImageMargins", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"10", ",", "0"}], "}"}]}], "}"}]}], ",", 
        RowBox[{"ImageSize", "->", 
