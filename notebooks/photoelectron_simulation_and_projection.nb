          RowBox[{"500", ",", "300"}], "}"}]}], ",", 
        RowBox[{"FrameMargins", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"10", ",", "0"}], "}"}]}], "}"}]}], ",", 
        RowBox[{"BaselinePosition", "->", "Center"}], ",", 
        RowBox[{"Background", "->", 
         RowBox[{"Lighter", "[", 
          RowBox[{"Blue", ",", " ", "0.8"}], "]"}]}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}]}]], "Input",
