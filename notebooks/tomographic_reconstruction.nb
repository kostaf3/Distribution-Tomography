(* Beginning of Notebook Content *)
Notebook[{

Cell[CellGroupData[{
Cell[TextData[StyleBox["Tomographic Reconstruction",
 FontColor->GrayLevel[0]]], "Subsection",
 CellChangeTimes->{{3.93885799107275*^9, 3.9388580020616465`*^9}, {
  3.9388624014208*^9, 
  3.938862404084696*^9}},ExpressionUUID->"ff301693-847b-4aea-948b-\
2119e467473a"],

Cell["\<\
This code takes as input projections of a distribution for various angles and \
produces slices which are combined to recreate the initial 3D distribution.
A mask is applied: If the highest valued point of the final image corresponds \
to 1, the pixels with values satisfying: 0 \[LessEqual] pixel_values \
\[LessEqual] n, where n=0,..,1 are set to zero while  the rest remain \
unchanged.You can choose the value of n.\
\>", "Text",
 CellChangeTimes->{{3.9388585606689987`*^9, 3.938858666569828*^9}, {
  3.9388595062419767`*^9, 3.938860259991152*^9}, {3.9388603076190243`*^9, 
  3.9388604600281234`*^9}, {3.938862428315583*^9, 3.93886245203713*^9}, {
  3.9388625418882217`*^9, 3.938862559822589*^9}, {3.938862599671671*^9, 
  3.9388626118263044`*^9}, {3.93886277965186*^9, 3.9388628014956083`*^9}, {
  3.938863006903308*^9, 3.9388630766867924`*^9}, {3.9388750483121166`*^9, 
  3.9388750485963316`*^9}, {3.9388751119939137`*^9, 3.9388751331890116`*^9}, {
  3.9388751793462486`*^9, 
  3.938875251861747*^9}},ExpressionUUID->"efb9c2f7-b7af-4bfd-a5f1-\
afd4e446e869"],

Cell["How to use the code:", "Text",
 CellChangeTimes->{
  3.9388604636572213`*^9},ExpressionUUID->"a4f41d0a-6fed-43cf-8b21-\
f1cfab1b1739"],

Cell["\<\
1. Run the code by pressing Evaluate Notebook or by pressing the \
right-hand-side Return key after clicking on the group cell.\
\>", "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.9388587013543377`*^9, 3.9388587995254025`*^9}, {
  3.9388588753496833`*^9, 3.938858935416108*^9}, {3.9388589778157396`*^9, 
  3.938859011381173*^9}, {3.938859085859496*^9, 3.938859118609809*^9}, {
  3.938859372948965*^9, 3.9388593889481864`*^9}, {3.9388605054505105`*^9, 
  3.9388605145301003`*^9}, {3.938860545920591*^9, 3.9388605514489117`*^9}, {
  3.9388606711876955`*^9, 3.938860671556138*^9}, {3.9388752898594236`*^9, 
  3.9388752928313456`*^9}},ExpressionUUID->"93076a6e-4eb5-4534-a994-\
a6dc23ff1cc3"],

Cell["\<\
2. Press \[OpenCurlyDoubleQuote]Import projection files\
\[CloseCurlyDoubleQuote] and select the data files of the projections. Only \
files in DAT format.\
\>", "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.938859411296795*^9, 3.9388594949490767`*^9}, {
   3.9388605717757053`*^9, 3.9388605893129635`*^9}, {3.9388606730635786`*^9, 
   3.9388606733576665`*^9}, 3.938861640326253*^9, {3.938863137206862*^9, 
   3.938863178420549*^9}, 
   3.938875341212697*^9},ExpressionUUID->"77f38c50-fee9-4217-b23b-\
e0e2a73a6b31"],

Cell["3. Choose the n-parameter of the mask.", "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.938859489179596*^9, 3.938859492181512*^9}, {
   3.93886061461578*^9, 3.9388606422843747`*^9}, {3.9388606744417553`*^9, 
   3.9388606747333355`*^9}, 
   3.938863186293185*^9},ExpressionUUID->"62e958dd-00a1-444a-a96b-\
4c350005e994"],

Cell["\<\
4. Press \[OpenCurlyDoubleQuote]Run\[CloseCurlyDoubleQuote] and the 3D \
reconstruction image will appear.
You can choose another n-parameter and run the code without having to import \
them again.\
\>", "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.9388606596886053`*^9, 3.9388606862605333`*^9}, {
  3.938860749536203*^9, 
  3.9388608300892344`*^9}},ExpressionUUID->"f1bde4a4-b2f8-4d39-8084-\
0beed25daacd"],

Cell["\<\
The program assumes the imported files hold data structured as: \
[pixels,slices].However, if, the dimensions  are interchanged then press \
\[OpenCurlyDoubleQuote]Transpose data\[CloseCurlyDoubleQuote].\
\>", "Text",
 CellChangeTimes->{{3.9388608451923637`*^9, 3.9388608496837864`*^9}, {
  3.9388608919321113`*^9, 3.9388609953598375`*^9}, {3.9388613818516617`*^9, 
  3.938861405159397*^9}, {3.9388614884522533`*^9, 3.938861562200775*^9}, {
  3.9388632243492193`*^9, 3.9388632725778923`*^9}, {3.93886331402207*^9, 
  3.938863344035906*^9}},ExpressionUUID->"4f36b0d0-e885-4a09-9f47-\
8637d5be1e82"],

Cell["\<\
The programm expects at least two data files with each one corresponding to a \
projection.\
\>", "Text",
 CellChangeTimes->{{3.9388633854176874`*^9, 3.9388634151385317`*^9}, {
  3.9388754150446053`*^9, 
  3.938875420207919*^9}},ExpressionUUID->"6f0696e4-4628-4f9c-b520-\
ac776c68f4d1"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", "initialization", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"$HistoryLength", "=", "0"}], ";"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SetDirectory", "[", 
     RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"CurrentValue", "[", 
      RowBox[{"$FrontEndSession", ",", "\"\<NotebookBrowseDirectory\>\""}], 
      "]"}], "=", 
     RowBox[{"NotebookDirectory", "[", 
      RowBox[{"EvaluationNotebook", "[", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"DynamicModule", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"importedfilesPath", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"importedfilesdat", "=", 
        RowBox[{"{", "}"}]}], ",", "importedfilesdatTransposed", ",", 
       RowBox[{"useTranspose", "=", "False"}], ",", "dataToUse", ",", 
       RowBox[{"result", "=", "Null"}], ",", "pixels", ",", "slices", ",", 
       "preSinosData", ",", "projections", ",", "filterOutZeros", ",", 
       "preSinosDataReduced", ",", "slicesReduced", ",", "diag", ",", 
       "sinograms", ",", "inverted", ",", "posAll", ",", "maskInverted", ",", 
       "np"}], "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Framed", "[", 
      RowBox[{
       RowBox[{"Column", "[", 
        RowBox[{"{", 
         RowBox[{"Labeled", "[", 
          RowBox[{
           RowBox[{"Framed", "[", 
            RowBox[{
             RowBox[{"Panel", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Column", "[", 
                RowBox[{
                 RowBox[{"{", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"Grid", "[", 
                    RowBox[{
                    RowBox[{"{", "\[IndentingNewLine]", "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{"panel", " ", "buttons"}], "*)"}], 
                    "\[IndentingNewLine]", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<Import projection files\>\"", ",", 
                    RowBox[{"FontSize", "->", "14"}], ",", 
                    RowBox[{"FontFamily", "->", "\"\<Times New Roman\>\""}]}],
                     "]"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"Button", "[", 
                    RowBox[{"\"\<Import Files\>\"", ",", 
                    RowBox[{
                    RowBox[{"importedfilesPath", "=", 
                    RowBox[{"SystemDialogInput", "[", 
                    RowBox[{"\"\<FileOpen\>\"", ",", "\"\<*.dat\>\""}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"importedfilesPath", "=!=", "$Canceled"}], ",", 
                    RowBox[{"importedfilesdat", "=", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"Import", "[", 
                    RowBox[{"importedfilesPath", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", 
                    RowBox[{"Length", "[", "importedfilesPath", "]"}]}], 
                    "}"}]}], "]"}]}]}], "]"}]}], ",", 
                    RowBox[{"Method", "->", "\"\<Queued\>\""}], ",", 
                    RowBox[{"ImageSize", "->", 
                    RowBox[{"{", 
                    RowBox[{"100", ",", "20"}], "}"}]}]}], "]"}]}], "}"}], 
                    ",", "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<Select n value: \>\"", ",", 
                    RowBox[{"FontSize", "->", "14"}], ",", 
                    RowBox[{"FontFamily", "->", "\"\<Times New Roman\>\""}]}],
                     "]"}], ",", 
                    RowBox[{"PopupMenu", "[", 
                    RowBox[{
                    RowBox[{"Dynamic", "[", "np", "]"}], ",", 
                    RowBox[{"Range", "[", 
                    RowBox[{"0.1", ",", "1.0", ",", "0.05"}], "]"}], ",", 
                    RowBox[{"Appearance", "->", "\"\<Popup\>\""}], ",", 
                    RowBox[{"ImageSize", "->", 
                    RowBox[{"{", 
                    RowBox[{"100", ",", "20"}], "}"}]}], ",", 
                    RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], "}"}], 
                    ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<Transpose Data: \>\"", ",", 
                    RowBox[{"FontSize", "->", "10"}], ",", 
                    RowBox[{"FontFamily", "->", "\"\<Times New Roman\>\""}]}],
                     "]"}], ",", 
                    RowBox[{"Checkbox", "[", 
                    RowBox[{"Dynamic", "[", "useTranspose", "]"}], "]"}]}], 
                    "}"}]}], "}"}], ",", 
                    RowBox[{"Alignment", "->", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"Left", ",", "Center"}], "}"}], ",", "Center"}], 
                    "}"}]}], ",", 
                    RowBox[{"Spacings", "->", 
                    RowBox[{"{", 
                    RowBox[{"Automatic", ",", " ", "1"}], "}"}]}]}], "]"}], 
                   ",", "\[IndentingNewLine]", 
                   RowBox[{"Spacer", "[", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "10"}], "}"}], "]"}], ",", 
                   "\[IndentingNewLine]", "\[IndentingNewLine]", 
                   "\[IndentingNewLine]", 
                   RowBox[{"(*", 
                    RowBox[{"Main", " ", "code", " ", "starts", " ", "here"}],
                     "*)"}], "\[IndentingNewLine]", 
                   RowBox[{"Button", "[", 
                    RowBox[{"\"\<Run\>\"", ",", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "importedfilesdat", "]"}], "==", 
                    "0"}], ",", 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{
                    "If", " ", "no", " ", "files", " ", "are", " ", 
                    "imported"}], ",", 
                    RowBox[{"show", " ", "a", " ", "message"}]}], "*)"}], 
                    RowBox[{
                    "MessageDialog", "[", 
                    "\"\<Please import files before running the code.\>\"", 
                    "]"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    "Determine", " ", "whether", " ", "to", " ", "use", " ", 
                    "original", " ", "or", " ", "transposed", " ", "data"}], 
                    "*)"}], 
                    RowBox[{
                    RowBox[{"dataToUse", "=", 
                    RowBox[{"If", "[", 
                    RowBox[{"useTranspose", ",", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"importedfilesdat", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "//", "Transpose"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", 
                    RowBox[{"Length", "[", "importedfilesdat", "]"}]}], 
                    "}"}]}], "]"}], ",", "importedfilesdat"}], "]"}]}], ";", 
                    "\[IndentingNewLine]", "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    "initial", " ", "parameters", " ", "and", " ", 
                    "functions"}], "*)"}], "\[IndentingNewLine]", 
                    RowBox[{"projections", "=", 
                    RowBox[{
                    RowBox[{"Dimensions", "[", "dataToUse", "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"pixels", ",", "slices"}], "}"}], "=", 
                    RowBox[{"Dimensions", "[", 
                    RowBox[{"dataToUse", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"preSinosData", "=", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"dataToUse", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "All", ",", "j"}], "]"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", "slices"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "projections"}], "}"}]}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"filterOutZeros", "[", "data_", "]"}], ":=", 
                    RowBox[{"Select", "[", 
                    RowBox[{"data", ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Total", "[", 
                    RowBox[{"Flatten", "[", "#", "]"}], "]"}], "!=", "0"}], 
                    "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"preSinosDataReduced", "=", 
                    RowBox[{"filterOutZeros", "[", "preSinosData", "]"}]}], 
                    ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
                    RowBox[{"slicesReduced", "=", 
                    RowBox[{
                    RowBox[{"Dimensions", "[", "preSinosDataReduced", "]"}], 
                    "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ";", 
                    "\[IndentingNewLine]", "\[IndentingNewLine]", 
                    "\[IndentingNewLine]", 
                    RowBox[{"diag", "=", 
                    RowBox[{"Round", "@", 
                    RowBox[{"Norm", "[", 
                    RowBox[{"{", 
                    RowBox[{"pixels", ",", "pixels"}], "}"}], "]"}]}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Times", "@@", 
                    RowBox[{"Boole", "[", 
                    RowBox[{"OddQ", "[", 
                    RowBox[{"{", 
                    RowBox[{"diag", ",", "pixels"}], "}"}], "]"}], "]"}]}], "==",
                     "0"}], "&&", 
                    RowBox[{
                    RowBox[{"Times", "@@", 
                    RowBox[{"Boole", "[", 
                    RowBox[{"EvenQ", "[", 
                    RowBox[{"{", 
                    RowBox[{"diag", ",", "pixels"}], "}"}], "]"}], "]"}]}], "==",
                     "0"}]}], ",", 
                    RowBox[{"diag", "=", 
                    RowBox[{"diag", "+", "1"}]}]}], "]"}], ";", 
                    "\[IndentingNewLine]", "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    "sinograms", " ", "and", " ", "inverted", " ", "slices"}],
                     "*)"}], "\[IndentingNewLine]", 
                    RowBox[{"sinograms", "=", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"ImagePad", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"preSinosDataReduced", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "//", "Rescale"}], "//", 
                    "Transpose"}], "//", "Image"}], "//", "ImageAdjust"}], 
                    ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"0", ",", "0"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"diag", "-", "pixels"}], ")"}], "/", "2"}], ",", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"diag", "-", "pixels"}], ")"}], "/", "2"}]}], 
                    "}"}]}], "}"}]}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "slicesReduced"}], "}"}]}], "]"}]}], 
                    ";", "\[IndentingNewLine]", 
                    RowBox[{"inverted", "=", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"ImageAdjust", "@", 
                    RowBox[{"Image", "@", 
                    RowBox[{"Rescale", "@", 
                    RowBox[{"ImageData", "[", 
                    RowBox[{"InverseRadon", "[", 
                    RowBox[{
                    RowBox[{"sinograms", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"pixels", ",", "pixels"}], "}"}]}], "]"}], 
                    "]"}]}]}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "slicesReduced"}], "}"}]}], "]"}]}], 
                    ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", "mask", "*)"}], "\[IndentingNewLine]", 
                    RowBox[{"posAll", "=", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"Position", "[", 
                    RowBox[{
                    RowBox[{"ImageData", "@", 
                    RowBox[{"inverted", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ",", 
                    RowBox[{"n_", "/;", 
                    RowBox[{"0", "<=", "n", "<=", "np"}]}]}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "slicesReduced"}], "}"}]}], "]"}]}], 
                    ";", "\[IndentingNewLine]", 
                    RowBox[{"maskInverted", "=", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"ReplacePart", "[", 
                    RowBox[{
                    RowBox[{"ImageData", "[", 
                    RowBox[{"inverted", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
                    RowBox[{"Thread", "[", 
                    RowBox[{
                    RowBox[{"posAll", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "->", 
                    RowBox[{"ConstantArray", "[", 
                    RowBox[{"0", ",", 
                    RowBox[{
                    RowBox[{"Dimensions", "[", 
                    RowBox[{"posAll", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "]"}]}], "]"}],
                     ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "slicesReduced"}], "}"}]}], "]"}]}], 
                    ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", " ", 
                    RowBox[{"3", "D", " ", "reconstructed", " ", "image"}], 
                    "*)"}], "\[IndentingNewLine]", 
                    RowBox[{"result", "=", 
                    RowBox[{"Image3D", "[", 
                    RowBox[{
                    RowBox[{"Image", "/@", "maskInverted"}], ",", 
                    RowBox[{"BoxRatios", "->", "Automatic"}], ",", 
                    RowBox[{"SphericalRegion", "->", "True"}], ",", 
                    RowBox[{"Background", "->", "None"}], ",", 
                    RowBox[{"Boxed", "->", "False"}], ",", 
                    RowBox[{
                    "ColorFunction", "->", "\"\<SandyTerrainOpacity\>\""}]}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                    "\[IndentingNewLine]", "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    "presentation", " ", "of", " ", "final", " ", "image", 
                    " ", "and", " ", "parameters", " ", "to", " ", "a", " ", 
                    "new", " ", "window"}], "*)"}], "\[IndentingNewLine]", 
                    "\[IndentingNewLine]", 
                    RowBox[{"CreateWindow", "[", 
                    RowBox[{
                    RowBox[{"CreateDocument", "[", 
                    RowBox[{"{", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"TextCell", "[", 
                    RowBox[{
                    "\"\<Calculation Complete. 3D reconstruction result:\>\"",
                     ",", "\"\<Subtitle\>\"", ",", 
                    RowBox[{"TextAlignment", "->", "Center"}]}], "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Dynamic", "[", "result", "]"}], 
                    "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                    RowBox[{"Column", "[", 
                    RowBox[{"{", 
                    RowBox[{"Grid", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"TextCell", "[", 
                    RowBox[{
                    RowBox[{"StringJoin", "[", 
                    RowBox[{"\"\<Number of projections= \>\"", ",", 
                    RowBox[{"ToString", "[", "projections", "]"}]}], "]"}], 
                    ",", 
                    RowBox[{"TextAlignment", "->", "Right"}]}], "]"}], "}"}], 
                    ",", 
                    RowBox[{"{", 
                    RowBox[{"TextCell", "[", 
                    RowBox[{
                    RowBox[{"StringJoin", "[", 
                    RowBox[{"\"\<Number of slices=      \>\"", ",", 
                    RowBox[{"ToString", "[", "slices", "]"}]}], "]"}], ",", 
                    RowBox[{"TextAlignment", "->", "Center"}]}], "]"}], "}"}],
                     ",", 
                    RowBox[{"{", 
                    RowBox[{"TextCell", "[", 
                    RowBox[{
                    RowBox[{"StringJoin", "[", 
                    RowBox[{"\"\<Number of pixels=      \>\"", ",", 
                    RowBox[{"ToString", "[", "pixels", "]"}]}], "]"}], ",", 
                    RowBox[{"TextAlignment", "->", "Center"}]}], "]"}], 
                    "}"}]}], "}"}], ",", 
